{
  "module": "calculators-json",
  "tools": [
    {
      "id": "tool_calc_gps_1.00",
      "title": "GPS Coordinate Conversion (DD ↔ DMS)-json",
      "content": [
        { "type": "gpsConverter" },
        { "type": "divider" },
        {
          "type": "text",
          "content": "Convert between Decimal Degrees (DD) and Degrees-Minutes-Seconds (DMS)."
        },
        {
          "type": "bullets",
          "items": [
            "DD → DMS: deg = int(DD); min = int(|DD − deg| × 60); sec = (|DD − deg| × 60 − min) × 60.",
            "DMS → DD: DD = deg + (min / 60) + (sec / 3600).",
            "Use N/E as positive, S/W as negative."
          ]
        },
        {
          "type": "text",
          "content": "Example: 37.7749° → 37° 46' 29.64\". 122° 25' 9.84\" W → −122.4194°."
        }
      ],
      "flashcards": [
        {
          "id": "flashcard_tool_calc_gps_1.00",
          "title": "DD ↔ DMS Basics-json",
          "sideA": [
            {
              "type": "text",
              "content": "Formula to convert DMS to DD?"
            }
          ],
          "sideB": [
            {
              "type": "text",
              "content": "DD = deg + (min/60) + (sec/3600). Use sign by hemisphere."
            }
          ]
        }
      ]
    },
    {
      "id": "tool_calc_dst_1.00",
      "title": "Speed / Time / Distance-json",
      "content": [
        {
          "type": "text",
          "content": "Quick relationships for trip planning and ETAs."
        },
        {
          "type": "bullets",
          "items": [
            "S = D / T (knots = NM per hour)",
            "D = S × T",
            "T = D / S"
          ]
        },
        {
          "type": "text",
          "content": "Example: 12 NM at 6 kn → 2 h. 18 NM in 3 h → 6 kn."
        }
      ],
